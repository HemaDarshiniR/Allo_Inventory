# ─── Postgres (Neon / Supabase) ───────────────────────────────────────────────
# Neon: Settings → Connection string → "Connection string" (pooled)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require&pgbouncer=true"
# Neon: Settings → Connection string → Direct
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# ─── Upstash Redis ────────────────────────────────────────────────────────────
# Upstash Console → Database → REST API → UPSTASH_REDIS_REST_URL / TOKEN
UPSTASH_REDIS_REST_URL="https://YOUR_UPSTASH_ENDPOINT.upstash.io"
UPSTASH_REDIS_REST_TOKEN="YOUR_TOKEN"

# ─── Cron secret (optional, recommended in prod) ──────────────────────────────
CRON_SECRET="some-random-secret-string"
